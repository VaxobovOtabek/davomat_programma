{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "server/**/*.ts",
    "scripts/**/*.ts",
    "api/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts"
  ]
}
